@GROUP_X = 180
@GROUP_Y = 5
@GROUP_WIDTH = 83
@GROUP_HEIGHT = 74

@POINTS_X = 59
@POINTS_Y = 69
@POINTS_WIDTH = 32
@POINTS_HEIGHT = 32
@POINTS_TEXT_X = 10
@POINTS_TEXT_Y = 6
@POINTS_TEXT_WIDTH = 10
@POINTS_TEXT_HEIGHT = 10

guiTypes = {
	containerWindowType = {
		name = "LEPEXP_gov_decision_cat_gui"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 110 }

		containerWindowType = {
			name = "serbia"
			position = { x = 0 y = 5 }
			size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

			iconType = {
				name = "serbia_icon"
				position = { x = 30 y = 0 }
				spriteType = "GFX_goal_constitutional_guarantees"

				pdx_tooltip = LEP_ZZH_tooltip
				pdx_tooltip_delayed = LEP_ZZH_tooltip_desc
			}

			containerWindowType = {
				name = "serbia_points"
				position = { x = @POINTS_X y = @POINTS_Y }
				size = { width = @POINTS_WIDTH height = @POINTS_HEIGHT }

				iconType = {
					name = "background"
					spriteType = "GFX_raid_type_background_round"
					pdx_tooltip = YUG_serbia_points_desc
				}

				instantTextBoxType = {
					name = "value"
					position = { x = @POINTS_TEXT_X y = @POINTS_TEXT_Y }
					font = "hoi_18mbs"
					text = YUG_serbia_points
					maxWidth = @POINTS_TEXT_WIDTH
					maxHeight = @POINTS_TEXT_HEIGHT
					fixedsize = yes
					format = center
					alwaystransparent = yes
				}
			}

			containerWindowType = {
				name = "croatia"
				position = { x = @GROUP_X y = 0 }
				size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

				iconType = {
					name = "croatia_icon"
					position = { x = 30 y = 0 }
					spriteType = "GFX_goal_ANQ_Dalu_Yinhang"

					pdx_tooltip = YUG_croatia_tooltip
					pdx_tooltip_delayed = YUG_croatia_tooltip_desc
				}

				containerWindowType = {
					name = "croatia_points"
					position = { x = @POINTS_X y = @POINTS_Y }
					size = { width = @POINTS_WIDTH height = @POINTS_HEIGHT }

					iconType = {
						name = "background"
						spriteType = "GFX_raid_type_background_round"
						pdx_tooltip = YUG_croatia_points_desc
					}

					instantTextBoxType = {
						name = "value"
						position = { x = @POINTS_TEXT_X y = @POINTS_TEXT_Y }
						font = "hoi_18mbs"
						text = YUG_croatia_points
						maxWidth = @POINTS_TEXT_WIDTH
						maxHeight = @POINTS_TEXT_HEIGHT
						fixedsize = yes
						format = center
						alwaystransparent = yes
					}
				}

				containerWindowType = {
					name = "bosnia"
					position = { x = @GROUP_X y = 0 }
					size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

					iconType = {
						name = "bosnia_icon"
						position = { x = 30 y = 0 }
						spriteType = "GFX_goal_ANQ_convince_intellectuals"

						pdx_tooltip = YUG_bosnia_tooltip
						pdx_tooltip_delayed = YUG_bosnia_tooltip_desc
					}

					containerWindowType = {
						name = "bosnia_points"
						position = { x = @POINTS_X y = @POINTS_Y }
						size = { width = @POINTS_WIDTH height = @POINTS_HEIGHT }

						iconType = {
							name = "background"
							spriteType = "GFX_raid_type_background_round"
							pdx_tooltip = YUG_bosnia_points_desc
						}

						instantTextBoxType = {
							name = "value"
							position = { x = @POINTS_TEXT_X y = @POINTS_TEXT_Y }
							font = "hoi_18mbs"
							text = YUG_bosnia_points
							maxWidth = @POINTS_TEXT_WIDTH
							maxHeight = @POINTS_TEXT_HEIGHT
							fixedsize = yes
							format = center
							alwaystransparent = yes
						}
					}
				}
			}
		}
	}

	containerWindowType = {
		name = "ui_progressbar"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 240 }

		iconType = {
			name ="progressbar"
			spriteType = "GFX_mod_progressbar"
			position = { x= 30	 y = 5 }
		}

		instantTextBoxType = {
			name ="progressbar_value"
			position = { x = 150 y = 80 }
			font = "hoi_24header"
			text = "[?progressbar_var]"
			format = center
			maxHeight = 24
		}
	}
}
