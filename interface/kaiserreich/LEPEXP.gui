@GROUP_X = 180
@GROUP_Y = 5
@GROUP_WIDTH = 83
@GROUP_HEIGHT = 74

@POINTS_X = 59
@POINTS_Y = 69
@POINTS_WIDTH = 32
@POINTS_HEIGHT = 32
@POINTS_TEXT_X = 10
@POINTS_TEXT_Y = 6
@POINTS_TEXT_WIDTH = 10
@POINTS_TEXT_HEIGHT = 10

guiTypes = {
	containerWindowType = {
		name = "LEPEXP_gov_decision_cat_gui"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 110 }

		containerWindowType = {
			name = "ZZH"
			position = { x = 0 y = 5 }
			size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

			iconType = {
				name = "ZZH_icon"
				position = { x = 30 y = 0 }
				spriteType = "GFX_goal_constitutional_guarantees"

				pdx_tooltip = LEP_ZZH_modifier_tooltip
				pdx_tooltip_delayed = LEP_ZZH_modifier_tooltip_desc
			}

			instantTextBoxType = {
			    name = "value"
			    position = { x = 30 y = 80 }
			    font = "hoi_24header"
			    text = [?LEP.party_popularity@social_liberal|%g2]
			    maxWidth = 80
			    maxHeight = 80
			    format = center
		    }
			

			containerWindowType = {
				name = "JNSB"
				position = { x = @GROUP_X y = 0 }
				size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

				iconType = {
					name = "JNSB_icon"
					position = { x = 30 y = 0 }
					spriteType = "GFX_goal_ANQ_Dalu_Yinhang"

					pdx_tooltip = LEP_JNSB_modifier_tooltip
					pdx_tooltip_delayed = LEP_JNSB_modifier_tooltip_desc
				}

				instantTextBoxType = {
			        name = "value"
			        position = { x = 30 y = 80 }
			        font = "hoi_24header"
			        text = [?LEP.party_popularity@social_conservative|%g2]
			        maxWidth = 80
			        maxHeight = 80
			        format = center
		        }
				

				containerWindowType = {
					name = "ZXX"
					position = { x = @GROUP_X y = 0 }
					size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

					iconType = {
						name = "ZXX_icon"
						position = { x = 30 y = 0 }
						spriteType = "GFX_goal_ANQ_convince_intellectuals"

						pdx_tooltip = LEP_ZXX_modifier_tooltip
						pdx_tooltip_delayed = LEP_ZXX_modifier_tooltip_desc
					}

					instantTextBoxType = {
			            name = "value"
			            position = { x = 30 y = 80 }
			            font = "hoi_24header"
			            text = [?LEP.party_popularity@market_liberal|%g2]
			            maxWidth = 80
			            maxHeight = 80
			            format = center
		            }
				}
			}
		}
	}

	containerWindowType = {
		name = "ui_military_mobilization"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 240 }

		iconType = {
			name ="military_mobilization"
			spriteType = "GFX_mod_military_mobilization"
			position = { x= 30	 y = 5 }
		}

		instantTextboxType = {
			name = "milmob_text"
			position = { x = 1 y = 95 }
			font = "hoi_24header"
			text = "LEP_military_mobilization_text"
			format = centre
			maxWidth = 490
			maxHeight = 340
			fixedsize = yes
		}
	}

	containerWindowType = {
		name = "ui_parliament"
		position = { x = 100 y = 100 }
		size = { width = 100% height = 110 }

		buttonType = {
			name = "parliament_button"
			spriteType = "GFX_goal_generic_parliament"
			clicksound = click_ok
			pdx_tooltip = "CLOSE"
			position = { x = 200 y = 0 }
			effect = {
				LEP_showcase_laws_effect = yes
			}

		}
	}
}
