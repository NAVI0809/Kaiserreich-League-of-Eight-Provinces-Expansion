@GROUP_X = 180
@GROUP_Y = 5
@GROUP_WIDTH = 83
@GROUP_HEIGHT = 74

@POINTS_X = 59
@POINTS_Y = 69
@POINTS_WIDTH = 32
@POINTS_HEIGHT = 32
@POINTS_TEXT_X = 10
@POINTS_TEXT_Y = 6
@POINTS_TEXT_WIDTH = 10
@POINTS_TEXT_HEIGHT = 10

guiTypes = {
	containerWindowType = {
		name = "LEPEXP_gov_decision_cat_gui"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 110 }

		containerWindowType = {
			name = "ZZH"
			position = { x = 0 y = 5 }
			size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

			iconType = {
				name = "ZZH_icon"
				position = { x = 30 y = 0 }
				spriteType = "GFX_goal_constitutional_guarantees"

				pdx_tooltip = LEP_ZZH_modifier_tooltip
				pdx_tooltip_delayed = LEP_ZZH_modifier_tooltip_desc
			}

			instantTextBoxType = {
			    name = "value"
			    position = { x = 30 y = 80 }
			    font = "hoi_24header"
			    text = [?LEP.party_popularity@social_liberal|%g2]
			    maxWidth = 80
			    maxHeight = 80
			    format = center
		    }
			

			containerWindowType = {
				name = "JNSB"
				position = { x = @GROUP_X y = 0 }
				size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

				iconType = {
					name = "JNSB_icon"
					position = { x = 30 y = 0 }
					spriteType = "GFX_goal_ANQ_Dalu_Yinhang"

					pdx_tooltip = LEP_JNSB_modifier_tooltip
					pdx_tooltip_delayed = LEP_JNSB_modifier_tooltip_desc
				}

				instantTextBoxType = {
			        name = "value"
			        position = { x = 30 y = 80 }
			        font = "hoi_24header"
			        text = [?LEP.party_popularity@social_conservative|%g2]
			        maxWidth = 80
			        maxHeight = 80
			        format = center
		        }
				

				containerWindowType = {
					name = "ZXX"
					position = { x = @GROUP_X y = 0 }
					size = { width = @GROUP_WIDTH height = @GROUP_HEIGHT } #matches icon size

					iconType = {
						name = "ZXX_icon"
						position = { x = 30 y = 0 }
						spriteType = "GFX_goal_ANQ_convince_intellectuals"

						pdx_tooltip = LEP_ZXX_modifier_tooltip
						pdx_tooltip_delayed = LEP_ZXX_modifier_tooltip_desc
					}

					instantTextBoxType = {
			            name = "value"
			            position = { x = 30 y = 80 }
			            font = "hoi_24header"
			            text = [?LEP.party_popularity@market_liberal|%g2]
			            maxWidth = 80
			            maxHeight = 80
			            format = center
		            }
				}
			}
		}
	}

	containerWindowType = {
		name = "ui_military_mobilization"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 240 }

		iconType = {
			name ="military_mobilization"
			spriteType = "GFX_mod_military_mobilization"
			position = { x= 30	 y = 5 }
		}

		instantTextboxType = {
			name = "milmob_text"
			position = { x = 1 y = 95 }
			font = "hoi_24header"
			text = "LEP_military_mobilization_text"
			format = centre
			maxWidth = 490
			maxHeight = 340
			fixedsize = yes
		}
	}

	containerWindowType = {
		name = "ui_parliament"
		position = { x = 0 y = 0 }
		size = { width = 100% height = 420 }

		buttonType = {
			name = "parliament_button"
			spriteType = "GFX_goal_generic_parliament"
			clicksound = click_ok
			pdx_tooltip = "LEP_parliament_button_tt"
			position = { x = 0 y = 0 }
			effect = {
				LEP_showcase_laws_effect = yes
			}
		}

		instantTextBoxType = {
			name = "LEP_passed_laws_title"
			position = { x = 70 y = 5 }
			font = "hoi_24header"
			text = "LEP_passed_laws_title"
			maxWidth = 300
			maxHeight = 28
			format = left
		}

		# 承接 gridbox 的容器：滚动条挂这里，只滚列表，不会带着按钮一起滚
		containerWindowType = {
			name = "LEP_passed_laws_container"
			position = { x = 6 y = 42 }
			size = { width = 490 height = 370 }
			margin = { top = 6 bottom = 6 }
			Orientation = upper_left
			verticalScrollbar = "right_vertical_slider"

			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_window_1b_thin_border"
			}

			gridboxType = {
				name = "LEP_passed_laws_grid"          # 必须与 scripted_gui 里 dynamic_lists 的键名逐字一致
				position = { x = 8 y = 0 }
				size = { width = 100%% height = 100%% }
				slotsize = { width = 470 height = 48 }  # 行距；高不能小于条目高，否则行与行重叠
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}
	}

	containerWindowType = {
		name = "LEP_passed_law_entry"
		size = { width = 470 height = 46 }
		clipping = yes

		# 背景做成 iconType 而不是 background，这样能挂整行 tooltip
		iconType = {
			name = "LEP_law_bg"
			spriteType = "GFX_diplo_countrylist_entry"
			position = { x = 0 y = 0 }
			pdx_tooltip = "LEP_GetPassedLawTooltip"
		}

		iconType = {
			name = "LEP_law_icon"
			spriteType = "GFX_LEP_law_icons"        # 14 帧的法案图标贴图；没做好就先换成 GFX_goal_generic_parliament 之类
			position = { x = 8 y = 7 }
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "LEP_law_name"
			position = { x = 52 y = 6 }
			font = "hoi_16mbs"
			text = "LEP_GetPassedLawName"
			maxWidth = 260
			maxHeight = 20
			fixedsize = yes
			format = left
		}

		instantTextBoxType = {
			name = "LEP_law_seq"
			position = { x = 318 y = 6 }
			font = "hoi_16mbs"
			text = "LEP_GetPassedLawSeq"
			maxWidth = 70
			maxHeight = 20
			fixedsize = yes
			format = left
		}

		instantTextBoxType = {
			name = "LEP_law_date"
			position = { x = 318 y = 24 }
			font = "hoi_16mbs"
			text = "LEP_GetPassedLawDate"
			maxWidth = 145
			maxHeight = 20
			format = left
		}
	}

	containerWindowType = {
		name = "ui_industry"
		position = { x = 100 y = 100 }
		size = { width = 100% height = 110 }

		buttonType = {
			name = "industrial_construction_button"
			spriteType = "GFX_idea_man_five_year_plan_industry"
			clicksound = click_ok
			pdx_tooltip = "LEP_industrial_construction_button_tt"
			position = { x = 100 y = 20 }
			effect = {
				
			}
		}

		buttonType = {
			name = "resource_allocation_button"
			spriteType = "GFX_idea_generic_loans"
			clicksound = click_ok
			pdx_tooltip = "LEP_resource_allocation_button_tt"
			position = { x = 200 y = 20 }
			effect = {
				
			}
		}
	}
}
